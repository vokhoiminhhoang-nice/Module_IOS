#!name=Locket Gold của bố Hoàng
#!desc=Mở khóa Locket Gold VIP & Luxury Features by @mhoang07
#!author=@mhoang07

[Script]
# 1. Xóa ETag RevenueCat
Locket Delete Header = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),script-path=https://raw.githubusercontent.com/vokhoiminhhoang-nice/Module_IOS/main/gistfile33.js

# 2. Mock Gói Thuê Bao Locket Gold
Locket Subscriptions = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),script-path=https://raw.githubusercontent.com/vokhoiminhhoang-nice/Module_IOS/main/gistfile11.js,requires-body=true,max-size=0

# 3. Firebase Remote Config (Luxury features, video 60s, caption VIP)
Locket Remote Config = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-camera\/namespaces\/firebase:fetch,script-path=https://raw.githubusercontent.com/vokhoiminhhoang-nice/Module_IOS/main/gistfile22.js,requires-body=true,max-size=0

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
